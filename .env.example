# Copy to .env and fill in. Never commit .env.

# --- App -----------------------------------------------------------------------
# development | staging | production | test
# production refuses to start unless LLM_PROVIDER=openai.
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM -----------------------------------------------------------------------
# Switching provider is an env change only. Pick one block.

# OpenAI (uses the Responses API for tool calling)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini

# Dev testing (Groq)
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b

# Dev testing (Gemini)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash

# Only the key for the selected provider is required.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional tuning (leave unset for provider defaults)
# LLM_TEMPERATURE=0.3
# low | medium | high (gemini also: minimal, openai also: none). Lower = faster first token.
# LLM_REASONING_EFFORT=low
# Extra model constructor kwargs as JSON
# LLM_MODEL_KWARGS={"max_tokens": 800}
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# --- MongoDB (chat sessions/messages, own database) ------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=edgemarket_chatbot

# --- EdgeMarket backend ----------------------------------------------------------
# prod: https://edgemarket.ai   staging: https://edgemarket-staging.webevis.com
EDGEMARKET_API_BASE_URL=https://edgemarket.ai
# Host used for market links in answers
EDGEMARKET_SITE_URL=https://edgemarket.ai
HTTP_TIMEOUT_S=10
STATS_CACHE_S=15

# --- Chat limits -----------------------------------------------------------------
HISTORY_LIMIT=20
MAX_MESSAGES_PER_SESSION=50
MAX_MESSAGE_CHARS=1000
SESSION_TTL_DAYS=30
RATE_LIMIT=20/5 minutes
SSE_PING_S=15
MAX_TOOL_CALLS_PER_TURN=6

# --- CORS ------------------------------------------------------------------------
# Comma separated, added to the built-in list: https://edgemarket.ai,
# https://www.edgemarket.ai, https://edgemarket-staging.webevis.com, http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
